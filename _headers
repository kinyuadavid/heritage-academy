# Netlify reads this file.
# The site sits on a private link, so search engines are kept away.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Fonts never change, so browsers can keep them for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photos: kept for a day, so a replaced photo shows up soon.
/assets/photos/*
  Cache-Control: public, max-age=86400

# Pages, styles and scripts: always check for the newest copy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
